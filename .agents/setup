#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
    local label="$1"
    shift
    local started=$SECONDS
    printf '\n==> %s\n' "$label"
    "$@"
    printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

prepare_python_environments() {
    local environment
    # Keep working environments from older snapshots, but reject interpreters
    # without wheels for the locked scientific dependencies before costly installs.
    for environment in .env .env-tests; do
        if [[ -x "$environment/bin/python" ]] && ! "$environment/bin/python" -c \
            'import sys; sys.exit(sys.version_info[:2] not in ((3, 11), (3, 12)))'; then
            echo "$environment requires Python 3.11 or 3.12; move it aside and rerun setup." >&2
            return 1
        fi
    done

    if [[ ! -x .env/bin/python || ! -x .env-tests/bin/python ]]; then
        # uv is provided by the orb. Match the Docker image and requirements CI,
        # rather than inheriting the base image's changing system Python version.
        uv python install 3.12
        local python
        python="$(uv python find --managed-python --no-python-downloads 3.12)"
        for environment in .env .env-tests; do
            if [[ ! -x "$environment/bin/python" ]]; then
                "$python" -m venv "$environment"
            fi
        done
    fi
    .env/bin/python --version
    .env-tests/bin/python --version
}

install_system_packages() {
    local packages=(
        build-essential
        curl
        git
        libcairo2-dev
        libgeos-dev
        libgif-dev
        libhdf5-dev
        libjpeg-dev
        libldap2-dev
        libpango1.0-dev
        librsvg2-dev
        libsasl2-dev
        libxml2-dev
        libxmlsec1-dev
        libxmlsec1-openssl
        libxslt1-dev
        p7zip-full
        pkg-config
        poppler-utils
        python3-dev
        python3-venv
        xvfb
        zlib1g-dev
    )
    local missing=()
    local package

    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
            missing+=("$package")
        fi
    done

    if ((${#missing[@]} == 0)); then
        echo "System packages are already installed"
        return
    fi

    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y "${missing[@]}"
}

install_node() {
    local node_version="v22.23.2"
    local node_home="$HOME/.local/node-$node_version"

    if [[ ! -x "$node_home/bin/node" ]]; then
        local archive
        archive="$(mktemp --suffix=.tar.xz)"
        trap 'rm -f "$archive"' RETURN
        curl --fail --location --retry 3 \
            "https://nodejs.org/dist/$node_version/node-$node_version-linux-x64.tar.xz" \
            --output "$archive"
        mkdir -p "$node_home"
        tar -xJf "$archive" --directory "$node_home" --strip-components=1
        rm -f "$archive"
        trap - RETURN
    fi

    export PATH="$node_home/bin:$PATH"
    corepack enable yarn
    node --version
    yarn --version
}

install_rust() {
    if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
        curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
            https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.85.1
    else
        if ! "$HOME/.cargo/bin/rustup" run 1.85.1 rustc --version >/dev/null 2>&1; then
            "$HOME/.cargo/bin/rustup" toolchain install 1.85.1 --profile minimal
        fi
        "$HOME/.cargo/bin/rustup" default 1.85.1
    fi

    export PATH="$HOME/.cargo/bin:$PATH"
    rustc --version
    cargo --version
}

configure_login_shell() {
    local node_home="$HOME/.local/node-v22.23.2"
    local marker="# CVAT orb development environment"

    touch "$HOME/.bash_profile"
    if grep -Fqx "$marker" "$HOME/.bash_profile"; then
        echo "Login shell is already configured"
        return
    fi

    cat >> "$HOME/.bash_profile" <<EOF

$marker
export PATH="$node_home/bin:\$PATH"
export PATH="$HOME/.cargo/bin:\$PATH"
if [[ "\${PWD}" == "$repo_root" || "\${PWD}" == "$repo_root/"* ]]; then
    source "$repo_root/.env/bin/activate"
fi
EOF
}

install_yarn_dependencies() {
    DISABLE_HUSKY=1 run_step "Install workspace JavaScript dependencies" yarn install --immutable
    (
        cd tests
        run_step "Install Cypress dependencies and binary" yarn install --immutable
    )
}

install_python_dependencies() {
    run_step "Upgrade server Python packaging tools" \
        .env/bin/python -m pip install --disable-pip-version-check --upgrade pip wheel setuptools

    # xmlsec's isolated build otherwise compiles the latest lxml as well as our
    # runtime pin. Match the pin so both builds reuse the same cached source wheel.
    local build_constraints="$repo_root/.env/build-constraints.txt"
    trap 'rm -f "$repo_root/.env/build-constraints.txt"' EXIT
    sed -n '/^lxml==/p' cvat/requirements/base.txt > "$build_constraints"
    run_step "Build shared lxml dependency" \
        .env/bin/python -m pip install --disable-pip-version-check \
        --no-binary lxml -r "$build_constraints"
    DATUMARO_HEADLESS=1 run_step "Install server Python dependencies (including native builds)" \
        .env/bin/python -m pip install --disable-pip-version-check \
        --build-constraint "$build_constraints" \
        --no-binary lxml,xmlsec \
        -r cvat/requirements/testing.txt \
        -r dev/requirements.txt
    rm -f "$build_constraints"
    trap - EXIT

    run_step "Upgrade REST-test Python packaging tools" \
        .env-tests/bin/python -m pip install --disable-pip-version-check --upgrade pip wheel setuptools
    run_step "Install REST-test Python dependencies" \
        .env-tests/bin/python -m pip install --disable-pip-version-check \
        -r tests/python/requirements.txt
}

run_step "Prepare compatible Python environments" prepare_python_environments
run_step "Install system packages" install_system_packages
run_step "Install Node.js and Yarn" install_node
run_step "Install Rust" install_rust
run_step "Install JavaScript dependencies" install_yarn_dependencies
run_step "Install Python dependencies" install_python_dependencies
run_step "Configure future login shells" configure_login_shell

mkdir -p logs keys
echo "CVAT orb setup complete"
